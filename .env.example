# --- FalkorDB connection ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_GRAPH=graphsleuth

# --- LLM (any OpenAI-compatible endpoint) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# auto = use live LLM if a key is present, otherwise scripted demo brain
# live = require a real key   demo = always scripted
LLM_MODE=auto

MAX_TOOL_ROUNDS=12
