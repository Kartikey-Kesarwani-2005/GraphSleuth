# --- FalkorDB connection (multigraph: every tenant gets its own graph) ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
# graph per tenant = <FALKORDB_GRAPH>:<tenant>  ->  graphsleuth:default, graphsleuth:acme
FALKORDB_GRAPH=graphsleuth

# --- LLM brain (real model picks its own tools; no scripted demo mode) ---
# Groq free tier: https://console.groq.com/keys  (OpenAI-compatible)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Primary model. Free tiers cap tokens PER MODEL per day, so list fallbacks in
# LLM_MODELS: when this model runs dry the agent switches to the next one.
GROQ_MODEL=openai/gpt-oss-120b
LLM_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b

# Any other OpenAI-compatible endpoint (OpenRouter / Gemini / local Ollama).
# GROQ_API_KEY wins if both are set.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# auto = live if a key is present, otherwise the offline fallback brain
# live = require a real key   demo = always the offline fallback
LLM_MODE=auto

# Free tiers rate-limit hard (Groq: 8k tokens/minute); keep reasoning tokens low.
# Only sent for reasoning models that accept it (e.g. gpt-oss). Blank = don't send.
LLM_REASONING_EFFORT=low

# The loop retries 429/5xx itself, honouring the API's "try again in Xs" hint,
# so a free-tier limit slows the investigation down instead of failing it.
MAX_TOOL_ROUNDS=20
